# Copy this file to .env and fill in real values. .env itself is gitignored.

# Local dev: leave DATABASE_URL and DATABASE_AUTH_TOKEN unset.
# The app then uses a local SQLite file at backend/db/annapurna.db (via Node's
# built-in node:sqlite) -- nothing else to install or configure.

# Production (Turso): set both of these to switch the same code to your
# hosted libSQL/Turso database instead. Get them from `turso db show <name>`
# and `turso db tokens create <name>` after creating a database at
# https://turso.tech (free tier is enough for this project).
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=

# Secret used to sign login session JWTs. Generate a real random value for
# any real deployment, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-value

PORT=4000

# Origin(s) allowed to call this API with credentials (cookies). Comma-separated.
CORS_ORIGIN=http://localhost:5173
